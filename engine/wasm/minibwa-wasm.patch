+	FILE *fp;
+	if (mb_bat.idx == 0 || (fp = fopen(fn, "wb")) == 0) return -1;
+	if (mb_bat.hdr) fputs(mb_bat.hdr, fp);
+	fclose(fp);
+	return 0;
