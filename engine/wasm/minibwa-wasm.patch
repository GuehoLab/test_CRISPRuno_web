+static void mb_batch_keep_state(const mb_opt_t *opt, mb_idx_t *idx, int32_t n, const char **fn, const char *hdr)
+{
+	int32_t i;
+	memset(&mb_bat, 0, sizeof(mb_bat));
+	mb_bat.opt = *opt;
+	mb_bat.idx = idx;
+	mb_bat.hdr = hdr? kom_strdup(hdr) : 0;
+	mb_bat.n_fn = n;
