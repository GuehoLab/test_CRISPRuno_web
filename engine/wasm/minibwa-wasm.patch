+/* Parallel BWTIncSortKey(): split the ranges into independent key intervals by 3-way partitioning
+ * (keys equal to the pivot are final), then sort the pieces with BWTIncSortKey() in parallel. Ties may
+ * end up in a different order than with the serial sort, which BWTIncBuildRelativeRank() and the suffix
+ * sort do not depend on: the keys come out identical and the BWT is unique. */
+typedef struct { bgint_t *key, *seq, n; } SortRange;
+typedef struct { SortRange *r; int n, m; } SortRanges;
+
+static void sortRangePush(SortRanges *s, bgint_t *key, bgint_t *seq, bgint_t n)
+{
+	if (n < 2) return;
+	if (s->n == s->m) {
+		s->m = s->m? s->m * 2 : 64;
+		s->r = (SortRange*)realloc(s->r, s->m * sizeof(SortRange));
+	}
+	s->r[s->n].key = key, s->r[s->n].seq = seq, s->r[s->n++].n = n;
+}
+
+static void sortRangeWorker(void *data, long i, int tid)
+{
+	SortRange *r = &((SortRanges*)data)->r[i];
+	(void)tid;
+	BWTIncSortKey(r->key, r->seq, r->n);
+}
+
