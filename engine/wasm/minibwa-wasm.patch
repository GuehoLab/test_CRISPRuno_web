+int mb_n_threads = 1; // [par] threads for SA sampling (mb_bwt_gen_sa) and bwtgen
+
+/* [par] Parallel SA sampling.
+ * The serial version walks the LF cycle once from rank 0 (the sentinel) and records SA[r] for
+ * every sampled rank r. Here the cycle is cut at every rank that is a multiple of 2^cut_shift:
+ * each piece is walked by one task, which stores (piece id << 40 | steps from the piece start)
+ * in place of the SA value. The pieces are then chained from rank 0, whose text position is
+ * known (seq_len), and a last pass turns the relative values into positions. Uses no memory
+ * beyond the SA array and three small per-piece arrays; the result is identical. */
+#define GENSA_OFF_BITS 40
+typedef struct {
+	mb_bwt_t *bwt;
+	int cut_shift;
+	uint64_t *len, *pos;
+	uint32_t *next;
+} gensa_aux_t;
+
+static void gensa_walk(void *data, long k, int tid)
+{
+	gensa_aux_t *g = (gensa_aux_t*)data;
+	mb_bwt_t *bwt = g->bwt;
+	uint64_t isa = (uint64_t)k << g->cut_shift, off = 0;
+	uint64_t mask = (1ULL<<bwt->sa_bit) - 1, cut_mask = (1ULL<<g->cut_shift) - 1;
+	(void)tid;
+	do {
+		if ((isa & mask) == 0) bwt->sa[isa >> bwt->sa_bit] = (uint64_t)k << GENSA_OFF_BITS | off;
+		++off;
+		isa = bwt_invPsi(bwt, isa);
+	} while (isa & cut_mask);
+	g->len[k] = off, g->next[k] = isa >> g->cut_shift;
+}
+
+static void gensa_fix(void *data, long k, int tid)
+{
+	gensa_aux_t *g = (gensa_aux_t*)data;
+	mb_bwt_t *bwt = g->bwt;
+	uint64_t i, st = (uint64_t)k << 20, en = st + (1ULL<<20);
+	(void)tid;
+	if (en > bwt->n_sa) en = bwt->n_sa;
+	for (i = st; i < en; ++i) {
+		uint64_t v = bwt->sa[i];
+		bwt->sa[i] = g->pos[v >> GENSA_OFF_BITS] - (v & ((1ULL<<GENSA_OFF_BITS) - 1));
+	}
+}
+
+static void mb_bwt_gen_sa_par(mb_bwt_t *bwt, uint32_t sa_bit, int n_threads)
+{
+	gensa_aux_t g;
+	uint64_t n_cut, k, j, p, tot = 0;
+	int cut_shift = 0;
+	while ((bwt->seq_len >> cut_shift) > (uint64_t)n_threads * 4096) ++cut_shift; // ~4096 pieces per thread
+	if (cut_shift < (int)sa_bit) cut_shift = sa_bit; // so that each piece covers at least one sampled rank on average
+	n_cut = (bwt->seq_len >> cut_shift) + 1; // ranks 0, 2^s, 2*2^s, ... <= seq_len
+	kom_assert(n_cut < 1ULL<<24 && bwt->seq_len < 1ULL<<GENSA_OFF_BITS, "genome too large for parallel SA sampling");
+	g.bwt = bwt, g.cut_shift = cut_shift;
+	g.len = kom_calloc(uint64_t, n_cut);
+	g.pos = kom_calloc(uint64_t, n_cut);
+	g.next = kom_calloc(uint32_t, n_cut);
+	kt_for(n_threads, gensa_walk, &g, n_cut);
+	for (k = 0, j = 0, p = bwt->seq_len; k < n_cut; ++k) { // chain the pieces along the cycle; rank 0 is at position seq_len
+		g.pos[j] = p;
+		p -= g.len[j], tot += g.len[j];
+		j = g.next[j];
+		if (j == 0) break;
+	}
+	kom_assert(j == 0 && k + 1 == n_cut && tot == bwt->seq_len + 1, "inconsistent LF cycle in parallel SA sampling");
+	kt_for(n_threads, gensa_fix, &g, (long)((bwt->n_sa + (1ULL<<20) - 1) >> 20));
+	free(g.len); free(g.pos); free(g.next);
