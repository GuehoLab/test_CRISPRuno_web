+
+// Same output as BWTIncGetAbsoluteRank(). scratch: >= numChar/8 bytes not overlapping anything in use
+static bgint_t BWTIncGetAbsoluteRankPar(BWT *bwt, bgint_t* __restrict absoluteRank, bgint_t* __restrict seq,
+										const unsigned int *packedText, const bgint_t numChar,
+										const bgint_t* cumulativeCount, const unsigned int firstCharInLastIteration,
+										uint8_t *scratch, int n_threads)
+{
+	AbsRankPar a;
+	bgint_t start[ALPHABET_SIZE], end[ALPHABET_SIZE], seg_len, idx;
+	int k, c, n_seg;
+
+	assert(numChar % CHAR_PER_WORD == 0);
+	n_seg = n_threads * 8;
+	seg_len = (numChar / n_seg + 63) / 64 * 64;
+	if (seg_len < 65536) seg_len = 65536;
+	n_seg = (numChar + seg_len - 1) / seg_len;
+
+	memset(&a, 0, sizeof(a));
+	a.bwt = bwt, a.text = packedText, a.numChar = numChar, a.n_seg = n_seg;
+	a.maxRank = bwt->textLength + 1;
+	a.side = scratch, a.seq = seq, a.absoluteRank = absoluteRank;
+	a.b = (bgint_t*)calloc(n_seg + 1, sizeof(bgint_t));
+	a.rankAtEnd = (bgint_t*)calloc(n_seg, sizeof(bgint_t));
+	a.cnt = calloc(n_seg, sizeof(*a.cnt));
+	a.off = calloc(n_seg, sizeof(*a.off));
+	for (k = 0; k < n_seg; ++k) a.b[k] = (bgint_t)k * seg_len;
+	a.b[n_seg] = numChar;
+	a.rankAtEnd[n_seg - 1] = bwt->inverseSa0;
+
+	if (n_seg > 1) kt_for(n_threads, absRankCheckpoint, &a, n_seg - 1);
+	kt_for(n_threads, absRankWalk, &a, n_seg);
+
+	for (c = 0; c < ALPHABET_SIZE; ++c)
+		start[c] = cumulativeCount[c], end[c] = cumulativeCount[c+1] - 1;
+	for (k = n_seg - 1; k >= 0; --k) { // segments with larger positions are processed first by the serial code
+		for (c = 0; c < ALPHABET_SIZE; ++c) {
+			a.off[k][c][0] = start[c], start[c] += a.cnt[k][c][0];
+			a.off[k][c][1] = end[c],   end[c]   -= a.cnt[k][c][1];
+		}
+	}
+	kt_for(n_threads, absRankPlaceRank, &a, n_seg); // reads seq[] (temporary ranks), writes absoluteRank[]
+	kt_for(n_threads, absRankPlaceSeq, &a, n_seg);  // overwrites seq[]
+
+	idx = start[firstCharInLastIteration];
+	absoluteRank[idx] = bwt->inverseSa0; // representing the substring of all preceding characters
+	seq[idx] = numChar;
