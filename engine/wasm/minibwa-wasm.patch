+/************************************************************************************
+ * [par] Multi-threaded parts of an iteration (results are identical to the serial  *
+ * code; only scratch space that bwtgen already reserves is used).                  *
+ ************************************************************************************/
+#include "kthread.h"
+extern int mb_n_threads;
+
+static inline unsigned int bgTextChar(const unsigned int *packedText, bgint_t r) // r-th character of the block
+{
+	return packedText[r / CHAR_PER_WORD] >> ((CHAR_PER_WORD - 1 - r % CHAR_PER_WORD) * BIT_PER_CHAR) & 3;
+}
+
+static inline bgint_t bgLF(const BWT *bwt, bgint_t r, unsigned int c) // the step of BWTIncGetAbsoluteRank()
+{
+	return bwt->cumulativeFreq[c] + BWTOccValue(bwt, r, c) + 1;
+}
+
+typedef struct {
+	const BWT *bwt;
+	const unsigned int *text;
+	bgint_t numChar, maxRank;
+	int n_seg;
+	bgint_t *b;          // segment k is [b[k], b[k+1])
+	bgint_t *rankAtEnd;  // rank of the suffix starting at b[k+1]
+	bgint_t (*cnt)[ALPHABET_SIZE][2], (*off)[ALPHABET_SIZE][2];
+	uint8_t *side;       // 1 bit per character: rank > inverseSa0
+	bgint_t *seq, *absoluteRank;
+} AbsRankPar;
+
+// Exact rank of the suffix starting at e (0 < e < numChar) without walking from the end of the block:
+// walk the same recurrence from the lowest and the highest possible rank over T[e, e+L); once the two
+// meet, the rank no longer depends on the unknown suffix after e+L. Longer L for repeats; at the end of
+// the block the true starting rank (inverseSa0) is known, so this always terminates with the exact value.
+static void absRankCheckpoint(void *data, long k, int tid)
+{
+	AbsRankPar *a = (AbsRankPar*)data;
+	bgint_t e = a->b[k + 1], L = 256, p, lo, hi;
+	(void)tid;
+	for (;;) {
+		bgint_t end = e + L;
+		if (end >= a->numChar) end = a->numChar, lo = hi = a->bwt->inverseSa0;
+		else lo = 0, hi = a->maxRank;
+		for (p = end; p > e;) {
+			unsigned int c = bgTextChar(a->text, --p);
+			if (lo == hi) lo = hi = bgLF(a->bwt, lo, c);
+			else lo = bgLF(a->bwt, lo, c), hi = bgLF(a->bwt, hi, c);
+		}
+		if (lo == hi) { a->rankAtEnd[k] = lo; return; }
+		L <<= 2;
+	}
+}
+
+static void absRankWalk(void *data, long k, int tid) // ranks of the segment's suffixes -> seq[r] (temporary), side bits, counts
+{
+	AbsRankPar *a = (AbsRankPar*)data;
+	bgint_t r, saIndex = a->rankAtEnd[k], inv = a->bwt->inverseSa0;
+	(void)tid;
+	memset(a->cnt[k], 0, sizeof(a->cnt[k]));
+	for (r = a->b[k + 1]; r > a->b[k];) {
+		unsigned int c = bgTextChar(a->text, --r), s;
+		saIndex = bgLF(a->bwt, saIndex, c);
+		a->seq[r] = saIndex;
+		s = saIndex > inv;
+		if (s) a->side[r >> 3] |= 1 << (r & 7);
+		else a->side[r >> 3] &= ~(1 << (r & 7));
+		a->cnt[k][c][s]++;
+	}
+}
+
+// the counting sort of BWTIncGetAbsoluteRank(): same slots, same order (characters are processed from the end)
+static void absRankPlaceRank(void *data, long k, int tid)
+{
+	AbsRankPar *a = (AbsRankPar*)data;
+	bgint_t r, pos[ALPHABET_SIZE][2];
+	(void)tid;
+	memcpy(pos, a->off[k], sizeof(pos));
+	for (r = a->b[k + 1]; r > a->b[k];) {
+		unsigned int c = bgTextChar(a->text, --r), s = a->side[r >> 3] >> (r & 7) & 1;
+		bgint_t d = s? pos[c][1]-- : pos[c][0]++;
+		a->absoluteRank[d] = a->seq[r];
+	}
+}
+
+static void absRankPlaceSeq(void *data, long k, int tid)
+{
+	AbsRankPar *a = (AbsRankPar*)data;
+	bgint_t r, pos[ALPHABET_SIZE][2];
+	(void)tid;
+	memcpy(pos, a->off[k], sizeof(pos));
+	for (r = a->b[k + 1]; r > a->b[k];) {
+		unsigned int c = bgTextChar(a->text, --r), s = a->side[r >> 3] >> (r & 7) & 1;
+		bgint_t d = s? pos[c][1]-- : pos[c][0]++;
+		a->seq[d] = r;
+	}
