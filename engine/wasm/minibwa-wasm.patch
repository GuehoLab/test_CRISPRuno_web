+int64_t mb_batch_run(int64_t max_reads, const char *fn_out) // returns the number of records mapped; 0 at EOF; <0 on error
+{
+	static char obuf[4<<20];
+	step_t *s;
+	int64_t n;
+	FILE *fp;
+	if (mb_bat.idx == 0 || mb_bat.n_fn < 1) return -1;
+	if (!mb_bat.opened) {
+		memset(&mb_bat.pl, 0, sizeof(pipeline_t));
+		mb_bat.pl.n_fp = mb_bat.n_fn;
+		mb_bat.pl.fp = mb_open_bseqs(mb_bat.n_fn, (const char**)mb_bat.fn);
+		if (mb_bat.pl.fp == 0) return -2;
+		mb_bat.pl.opt = &mb_bat.opt, mb_bat.pl.idx = mb_bat.idx;
+		mb_bat.pl.mb_size = mb_bat.opt.mb_size;
+		mb_bat.opened = 1;
+	}
+	if ((fp = fopen(fn_out, "wb")) == 0) return -3;
+	setvbuf(fp, obuf, _IOFBF, sizeof(obuf));
+	mb_bat.pl.fp_out = fp;
+	mb_bat.pl.max_reads = max_reads;
+	s = (step_t*)worker_pipeline(&mb_bat.pl, 0, 0);
+	if (s == 0) { fclose(fp); return 0; }
+	n = s->n_seq;
+	worker_pipeline(&mb_bat.pl, 1, s);
+	worker_pipeline(&mb_bat.pl, 2, s); // frees s
+	fclose(fp);
+	return n;
+}
+
+void mb_batch_close(void)
+{
+	int32_t i;
+	if (mb_bat.opened) {
+		for (i = 0; i < mb_bat.pl.n_fp; ++i) mb_bseq_close(mb_bat.pl.fp[i]);
+		free(mb_bat.pl.fp);
+	}
+	if (mb_bat.idx) mb_idx_destroy(mb_bat.idx);
+	for (i = 0; i < mb_bat.n_fn; ++i) free(mb_bat.fn[i]);
+	free(mb_bat.fn); free(mb_bat.hdr);
+	memset(&mb_bat, 0, sizeof(mb_bat));
